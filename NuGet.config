<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-scoped package source. The machine-wide NuGet.Config at
  %APPDATA%\NuGet\NuGet.Config has an intentionally empty <packageSources>
  block; this file restores nuget.org for THIS repo only.

  It lives at the monorepo root so every mod project resolves it. NuGet walks
  up from the project directory, so a per-mod copy would only cover that mod.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
