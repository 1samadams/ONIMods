<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net48, NOT net471. The game ships 0Harmony.dll built against .NET Framework
      4.8; targeting 4.7.1 makes MSBuild refuse to resolve it (MSB3274) and, via
      the indirect dependency, Assembly-CSharp too (MSB3275), which fails the build
      with every game type "not found".
    -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AutoMachines</AssemblyName>
    <RootNamespace>AutoMachines</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!-- Game DLLs are reference-only; never copy them to output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedDir>C:\Program Files (x86)\Steam\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</ManagedDir>
    <ModDeployDir>$(USERPROFILE)\Documents\Klei\OxygenNotIncluded\mods\Local\AutoMachines</ModDeployDir>
    <ModAssetsDir>$(MSBuildProjectDirectory)\..\..\mod</ModAssetsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies the net48 targeting pack, so the build does not depend on which
         .NET Framework dev packs happen to be installed on the machine. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!--
    Build -> test in one command. The DLL and yaml are overwritten every build;
    config.json is copied ONLY if absent so a player's edits survive rebuilds.
  -->
  <Target Name="DeployToLocalMods" AfterTargets="Build">
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="$(ModAssetsDir)\mod.yaml;$(ModAssetsDir)\mod_info.yaml" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="$(ModAssetsDir)\config.json" DestinationFolder="$(ModDeployDir)"
          Condition="!Exists('$(ModDeployDir)\config.json')" />
    <Message Importance="high" Text="AutoMachines deployed to $(ModDeployDir)" />
  </Target>

</Project>
