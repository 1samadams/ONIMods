<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework (net48), LangVersion, the game references and the
    Microsoft.NETFramework.ReferenceAssemblies package all come from
    Directory.Build.props at the monorepo root. Only what is specific to this
    mod lives here.
  -->

  <PropertyGroup>
    <AssemblyName>UnlockAllBlueprints</AssemblyName>
    <RootNamespace>UnlockAllBlueprints</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ModAssetsDir>$(MSBuildProjectDirectory)\..\..\mod</ModAssetsDir>
    <StageDir>$(MSBuildProjectDirectory)\..\..\dist\UnlockAllBlueprints</StageDir>
  </PropertyGroup>

  <!--
    Stage the built DLL next to mod.yaml/mod_info.yaml so the folder can be
    copied or symlinked straight into the game's Local mods directory.

    This replaces the old CopyToOutputRoot target, which dropped the DLL beside
    the yamls back when both sat at the repo root. The yamls now live in mod/,
    so staging into dist/ is how the two get combined.
  -->
  <Target Name="StageMod" AfterTargets="Build">
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(ModAssetsDir)\mod.yaml;$(ModAssetsDir)\mod_info.yaml"
          DestinationFolder="$(StageDir)" />
    <Message Importance="high" Text="UnlockAllBlueprints staged at $(StageDir)" />
  </Target>

</Project>
