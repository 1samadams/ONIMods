<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework (net48), LangVersion, the game references and the
    Microsoft.NETFramework.ReferenceAssemblies package all come from
    Directory.Build.props at the monorepo root. Only what is specific to this
    mod lives here.

    This project was reconstituted from the shipped 0.4.1 DLL (Steam item
    3755915137) after the original source was lost. See README.md.
  -->

  <PropertyGroup>
    <AssemblyName>FastInsulatedSelfSealingAirLock</AssemblyName>
    <RootNamespace>FastInsulatedSelfSealingAirLock</RootNamespace>
    <Version>0.4.2</Version>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!--
      Directory.Build.props sets this false so Klei's DLLs stay out of the
      output. This mod is the exception: PLib arrives via NuGet and must land
      in the output folder for the ILRepack step below to find and merge it.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Must resolve the REAL Documents folder, not $(USERPROFILE)\Documents.
      OneDrive Known Folder Move redirects Documents to %USERPROFILE%\OneDrive\
      Documents; the game follows the redirect but $(USERPROFILE)\Documents does
      not, so the literal path silently deploys to a folder the game never reads.
    -->
    <DocumentsDir>$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))</DocumentsDir>
    <ModDeployDir>$(DocumentsDir)\Klei\OxygenNotIncluded\mods\Local\FastInsulatedSelfSealingAirLock</ModDeployDir>
    <ModAssetsDir>$(MSBuildProjectDirectory)\..\..\mod</ModAssetsDir>
    <StageDir>$(MSBuildProjectDirectory)\..\..\dist\FastInsulatedSelfSealingAirLock</StageDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Options.cs serialises the config file with Newtonsoft attributes. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      PeterHan's PLib: supplies the options screen (POptions/SingletonOptions)
      and the .po localisation loader (PLocalization). It is designed to be
      merged into the mod assembly rather than shipped alongside it, so that
      every mod carries its own version and they arbitrate at runtime through
      PRegistry. The ILRepack target below does that merge.
    -->
    <PackageReference Include="PLib" Version="4.25.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Merge PLib into FastInsulatedSelfSealingAirLock.dll, matching how the
    shipped 0.4.1 build was packaged. Without this the mod loads and then
    throws FileNotFoundException on PLib at first use, because ONI does not
    probe the mod folder for sibling assemblies.
  -->
  <Target Name="MergePLib" AfterTargets="Build" Condition="Exists('$(TargetDir)PLib.dll')">
    <ItemGroup>
      <MergeInputs Include="$(TargetPath)" />
      <MergeInputs Include="$(TargetDir)PLib.dll" />
    </ItemGroup>
    <ILRepack
      Parallel="true"
      Internalize="true"
      InputAssemblies="@(MergeInputs)"
      TargetKind="Dll"
      LibraryPath="$(GameLibsDir)"
      OutputFile="$(TargetPath)" />
    <Delete Files="$(TargetDir)PLib.dll" />
    <Message Importance="high" Text="PLib merged into $(TargetPath)" />
  </Target>

  <!--
    Stage the complete, ready-to-install mod folder inside the repo. This always
    succeeds, and is what you hand-copy if the deploy step below is blocked.
  -->
  <Target Name="StageMod" AfterTargets="MergePLib">
    <ItemGroup>
      <ModAssets Include="$(ModAssetsDir)\**\*" Exclude="$(ModAssetsDir)\**\*.dll" />
    </ItemGroup>
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(StageDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="FastInsulatedSelfSealingAirLock staged at $(StageDir)" />
  </Target>

  <!--
    Deploy into the game's Local mods folder. ContinueOnError is deliberate:
    Windows Controlled Folder Access (ransomware protection) guards the real
    Documents folder and blocks MSBuild from writing there, failing with a
    misleading "Could not find file". A blocked deploy must not fail the build;
    the staged folder above is still valid, just copy it across manually.
  -->
  <Target Name="DeployToLocalMods" AfterTargets="StageMod">
    <MakeDir Directories="$(ModDeployDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(ModDeployDir)')" />
    <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(ModDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(ModDeployDir)')" />
    <Message Importance="high" Condition="Exists('$(ModDeployDir)\FastInsulatedSelfSealingAirLock.dll')"
             Text="FastInsulatedSelfSealingAirLock deployed to $(ModDeployDir)" />
    <Message Importance="high" Condition="!Exists('$(ModDeployDir)\FastInsulatedSelfSealingAirLock.dll')"
             Text="FastInsulatedSelfSealingAirLock could NOT auto-deploy (Controlled Folder Access?). Copy $(StageDir) to $(ModDeployDir) manually." />
  </Target>

</Project>
