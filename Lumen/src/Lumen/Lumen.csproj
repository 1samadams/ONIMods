<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework (net48), LangVersion, the game references and the
    Microsoft.NETFramework.ReferenceAssemblies package all come from
    Directory.Build.props at the monorepo root. Only what is specific to this
    mod lives here.
  -->

  <PropertyGroup>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <Version>1.1.0</Version>
    <EnableDefaultItems>true</EnableDefaultItems>
    <!--
      Directory.Build.props sets this false so Klei's DLLs stay out of the
      output. This mod is an exception: PLib arrives via NuGet and must land in
      the output folder for the ILRepack step to find and merge it.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Must resolve the REAL Documents folder, not $(USERPROFILE)\Documents.
      OneDrive Known Folder Move redirects Documents to %USERPROFILE%\OneDrive\
      Documents; the game follows the redirect but $(USERPROFILE)\Documents does
      not, so the literal path silently deploys to a folder the game never reads.
    -->
    <DocumentsDir>$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))</DocumentsDir>
    <ModDeployDir>$(DocumentsDir)\Klei\OxygenNotIncluded\mods\Local\Lumen</ModDeployDir>
    <ModAssetsDir>$(MSBuildProjectDirectory)\..\..\mod</ModAssetsDir>
    <StageDir>$(MSBuildProjectDirectory)\..\..\dist\Lumen</StageDir>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Mod-specific: Options uses Newtonsoft attributes, PLib serialises through
      it, and Settings reads the legacy config.json with it during migration.
    -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Peter Han's PLib: supplies the Mods-menu options dialog (POptions /
      SingletonOptions). Designed to be merged into the mod assembly rather than
      shipped alongside it, so every mod carries its own version and they
      arbitrate at runtime through PRegistry.
    -->
    <PackageReference Include="PLib" Version="4.25.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The MergePLib target lives in ILRepack.targets beside this file, not here,
    and that file's EXISTENCE is load-bearing: ILRepack.Lib.MSBuild.Task runs its
    own in-place merge in Release unless that exact filename exists, and that
    merge cannot resolve the game's Newtonsoft.Json. This mod is built in
    Release, so it would hit that. Full reasoning in the file itself.
    $(MergedAssembly), used by the two targets below, is set by it.
  -->

  <!--
    Stage the complete, ready-to-install mod folder inside the repo. This always
    succeeds, and is what you hand-copy if the deploy step below is blocked.

    There is no config.json here. PLib owns the settings file now and writes it
    to the game's shared mods\config\ folder on first run.
  -->
  <Target Name="StageMod" AfterTargets="MergePLib">
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(MergedAssembly)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(ModAssetsDir)\mod.yaml;$(ModAssetsDir)\mod_info.yaml"
          DestinationFolder="$(StageDir)" />
    <Message Importance="high" Text="Lumen staged at $(StageDir)" />
  </Target>

  <!--
    Deploy into the game's Local mods folder. ContinueOnError is deliberate:
    Windows Controlled Folder Access (ransomware protection) guards the real
    Documents folder and blocks MSBuild from writing there, failing with a
    misleading "Could not find file". A blocked deploy must not fail the build;
    the staged folder above is still valid, just copy it across manually.

    An existing config.json in the deployed folder is left alone: it is what the
    one-time migration in Settings reads.
  -->
  <Target Name="DeployToLocalMods" AfterTargets="StageMod">
    <MakeDir Directories="$(ModDeployDir)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(MergedAssembly)" DestinationFolder="$(ModDeployDir)"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(ModDeployDir)')" />
    <Copy SourceFiles="$(ModAssetsDir)\mod.yaml;$(ModAssetsDir)\mod_info.yaml" DestinationFolder="$(ModDeployDir)"
          ContinueOnError="WarnAndContinue" Condition="Exists('$(ModDeployDir)')" />
    <Message Importance="high" Condition="Exists('$(ModDeployDir)\Lumen.dll')"
             Text="Lumen deployed to $(ModDeployDir)" />
    <Message Importance="high" Condition="!Exists('$(ModDeployDir)\Lumen.dll')"
             Text="Lumen could NOT auto-deploy (Controlled Folder Access?). Copy $(StageDir) to $(ModDeployDir) manually." />
  </Target>

</Project>
